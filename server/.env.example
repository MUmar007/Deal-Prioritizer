# Copy to server/.env for local development. Every key is required.

# Postgres from `docker compose up -d db` (host port 5433)
DATABASE_URL=postgresql+asyncpg://deal:deal@localhost:5433/dealprioritizer

# Redis from `docker compose up -d redis`. Leave empty to cache in memory instead.
REDIS_URL=redis://localhost:6380/0

# How long geocodes and discovery results stay cached, in seconds
CACHE_SECONDS=3600

# Timeout for geocoder requests, in seconds
HTTP_TIMEOUT=15

# Identify the app with a real contact (Nominatim's policy). Overpass rejects
# placeholders like example.com with a 406, so use your repo URL or email.
NOMINATIM_UA=DealPrioritizer/1.0 (+https://github.com/MUmar007/Deal-Prioritizer)

# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://127.0.0.1:4173"]
